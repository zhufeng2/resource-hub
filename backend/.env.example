# DNS must point to your Linux server. Use a dedicated subdomain, no path.
PUBLIC_BASE_URL=https://search.example.com

# Copy the exact callback URI displayed by ChatGPT. Comma-separate if more than one.
# This service sends RFC 9207 issuer identification, so the stable ChatGPT callback applies.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect

# Configure either a fixed token OR the username/password pair. Never commit real values.
PANSOU_BASE_URL=https://pansou.example.com
PANSOU_API_TOKEN=
PANSOU_USERNAME=
PANSOU_PASSWORD=

# Set true only when PanSou is reached over your private internal HTTP network.
PANSOU_ALLOW_HTTP=false

DEFAULT_DAILY_LIMIT=5
SEARCH_TIMEOUT=25
SEARCH_CONCURRENCY=4

# Fernet key for Quark cookies. Prefer a secret manager in production; empty uses a local 0600 key file.
QUARK_SECRET_KEY=
# Local deployments only: optional Node.js executable path. Docker provides node.
# QUARK_NODE_BINARY=node

# Email-verified registration opens only when SMTP is configured. Set false to close registration.
REGISTRATION_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
# ssl (465) or starttls (usually 587); TLS certificate verification is required.
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
